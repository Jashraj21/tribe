{
  "name": "tribe-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade Node.js/TypeScript backend for TRIBE (District clone) with Razorpay engine, PostgreSQL/Prisma, Redis seat-locking, and dynamic pass scanner",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "tribe",
    "district",
    "razorpay",
    "tickets",
    "seat-locking",
    "northeast",
    "prisma",
    "postgresql"
  ],
  "author": "TRIBE Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
